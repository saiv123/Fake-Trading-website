FLASK_ENV=production
DATABASE_URL=mssql+pyodbc://user:pass@server.database.windows.net/dbname?driver=ODBC+Driver+18+for+SQL+Server
FRONTEND_URL=http://localhost:5173
# Signs website login session tokens — set this to a fixed random value in production.
# Sessions are invalidated on every restart if left unset (see app/__init__.py).
FLASK_SECRET_KEY=
MARKETDATA_API_TOKEN=
FMP_API_KEY=
# Identifies the Discord bot process only — never used by the website (it authenticates with a
# per-user session token instead, minted at OAuth login).
BOT_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
